{
  "routes": [
    {
      "route": "/*",
      "requiresAuthentication": true,
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/upload",
      "allowedRoles": ["content-manager"]
    },
    {
      "route": "/manage",
      "allowedRoles": ["content-manager"]
    },
    {
      "route": "/api/*",
      "requiresAuthentication": true,
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/upload",
      "allowedRoles": ["content-manager"],
      "methods": ["POST"]
    },
    {
      "route": "/api/resource/*",
      "allowedRoles": ["content-manager"],
      "methods": ["PUT", "DELETE"]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/*.{css,js,png,jpg,svg,ico}"]
  },
  "responseOverrides": {
    "401": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    },
    "403": {
      "redirect": "/.auth/login/aad",
      "statusCode": 302
    }
  }
}
